# Server-only. Never prefix this with NEXT_PUBLIC and never send it to the browser.
# Also set a monthly hard spend limit in the OpenAI dashboard. See SECURITY.md.
OPENAI_API_KEY=
# Chat model. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Cost protection. The in-memory limiter is the default and is per server process.
CHAT_RATE_LIMIT_PER_DAY=20
# Contact form submissions per hashed IP per day. Hard-capped at 20.
CONTACT_RATE_LIMIT_PER_DAY=5
CHAT_MAX_OUTPUT_TOKENS=600
CHAT_MAX_USER_CHARS=2000
CHAT_MAX_HISTORY=16
# memory | upstash | supabase
RATE_LIMIT_PROVIDER=memory
# Optional salt mixed into the hashed client key.
RATE_LIMIT_SALT=
# Trust x-forwarded-for and x-real-ip. Set true on Railway (and any reverse proxy
# that overwrites those headers). Vercel, Cloudflare, and Fly are detected without it.
TRUST_PROXY_HEADERS=
# Public site origin used for the /api/chat same-origin check, for example https://example.com.
NEXT_PUBLIC_SITE_URL=

# Upstash Redis. Used only when RATE_LIMIT_PROVIDER=upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase. Both are server-only. Required for the contact form.
# Also used for the rate-limit RPC when RATE_LIMIT_PROVIDER=supabase, and later for pgvector.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# static (default, full site text in the prompt) | pgvector
KNOWLEDGE_PROVIDER=static

# Langfuse tracing. Omitted keys disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# PostHog analytics. Omitted key disables the client SDK.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry. Omitted DSN disables error reporting. No auth token is required to build.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
